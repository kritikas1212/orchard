// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  description   String
  priceCents    Int
  compareAtCents Int?
  sku           String?
  images        String[]   // urls
  categories    Category[] @relation("ProductCategories")
  variants      Json?
  inventory     Int
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[] @relation("ProductCategories")
}

model Order {
  id         String   @id @default(cuid())
  userId     String?
  totalCents Int
  items      Json
  status     String
  stripeId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LabReport {
  id          String   @id @default(cuid())
  title       String
  description String?
  pdfUrl      String
  thumbnailUrl String?
  productId   String?
  createdAt   DateTime @default(now())
}
